APP_NAME="SIALU API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_LOGIN_TIMEOUT=10
DB_QUERY_TIMEOUT=30
DB_SP_FIND_USER=dbo.sp_catcUsuarios
DB_SP_SESSION_TIMEOUT=dbo.sp_catcTiempoSesiones
DB_SP_SESSIONS=dbo.sp_movcSesiones
DB_SP_SESSION_TIMEOUT_ACTION=5
DB_SP_SESSION_CREATE_ACTION=1
DB_SP_SESSION_CLOSE_ACTION=6
DB_SP_SESSION_EXPIRE_ACTION=7
DB_SP_SESSION_FIND_ACTION=5

LDAP_SCHEME=ldap
LDAP_HOST=
LDAP_PORT=389
LDAP_URI=
LDAP_BASE_DN=
LDAP_PEOPLE_OU=ou=People
LDAP_GROUPS_OU=ou=Groups
LDAP_READONLY_DN=
LDAP_READONLY_PASS=
LDAP_USER_DN=
LDAP_PASSWORD=
LDAP_SUPPORT_GROUP=Soporte
LDAP_SUPPORT_GID=5003
LDAP_PROTOCOL_VERSION=3
LDAP_NETWORK_TIMEOUT=10
LDAP_REFERRALS=false
LDAP_START_TLS=false
LDAP_USER_FILTER="(&(objectClass=inetOrgPerson)(uid=%s))"
LDAP_SUPPORT_GROUP_FILTER="(&(objectClass=posixGroup)(cn=%s)(gidNumber=%d))"
LDAP_PASSWORD_ENCRYPTION_CIPHER=aes-256-gcm
LDAP_PASSWORD_ENCRYPTION_KEY_BASE64=

SESSION_DRIVER=file
SESSION_COOKIE=sialu_api_session
# La regla de inactividad se obtiene de catcTiempoSesiones; este es el máximo de almacenamiento.
SESSION_LIFETIME=1440
SESSION_REGENERATE_INTERVAL=300
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300

APP_TIMEZONE=America/Mexico_City

# Integraciones: completar IDs reales de catcFuentes. No activar hasta validar esquema y mapas.
SIALU_PERSISTENCE_ENABLED=false
ORION_SOURCE_ID=
ORION_HOST=
ORION_PORT=17778
ORION_USERNAME=
ORION_PASSWORD=
ORION_SSL_VERIFY=true
PALOALTO_SOURCE_ID=
PALOALTO_HOST=
PALOALTO_PORT=443
PALOALTO_API_KEY=
PALOALTO_SSL_VERIFY=true
PALOALTO_TIMEZONE=
