APP_NAME="SIALU API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_LOGIN_TIMEOUT=10
DB_QUERY_TIMEOUT=30
DB_SP_FIND_USER=dbo.sp_catcUsuarios
DB_SP_SESSIONS=dbo.sp_movcSesiones
DB_SP_SESSION_CREATE_ACTION=1
DB_SP_SESSION_CLOSE_ACTION=6
DB_SP_SESSION_EXPIRE_ACTION=7
DB_SP_SESSION_FIND_ACTION=5

LDAP_SCHEME=ldap
LDAP_HOST=
LDAP_PORT=389
LDAP_URI=
LDAP_BASE_DN=
LDAP_PEOPLE_OU=ou=People
LDAP_GROUPS_OU=ou=Groups
LDAP_READONLY_DN=
LDAP_READONLY_PASS=
LDAP_USER_DN=
LDAP_PASSWORD=
LDAP_SUPPORT_GROUP=Soporte
LDAP_SUPPORT_GID=5003
LDAP_PROTOCOL_VERSION=3
LDAP_NETWORK_TIMEOUT=10
LDAP_REFERRALS=false
LDAP_START_TLS=false
LDAP_USER_FILTER="(&(objectClass=inetOrgPerson)(uid=%s))"
LDAP_SUPPORT_GROUP_FILTER="(&(objectClass=posixGroup)(cn=%s)(gidNumber=%d))"

SESSION_DRIVER=file
SESSION_COOKIE=sialu_api_session
# Máximo de almacenamiento de la sesión; no hay cierre por inactividad (ver README).
SESSION_LIFETIME=1440
SESSION_REGENERATE_INTERVAL=300
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
LOGIN_THROTTLE_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=300

APP_TIMEZONE=America/Mexico_City

# Ruta opcional de LibreOffice para convertir la plantilla Word del reporte mensual a PDF.
SIALU_LIBREOFFICE_PATH=

# Integraciones: completar IDs reales de catcFuentes. No activar hasta validar esquema y mapas.
SIALU_PERSISTENCE_ENABLED=false
ORION_SOURCE_ID=
ORION_HOST=
ORION_PORT=17778
ORION_USERNAME=
ORION_PASSWORD=
ORION_SSL_VERIFY=true
# Certificado (PEM) en que confiar para Orion cuando no lo emite una CA del bundle de PHP.
ORION_CA_FILE=
# SOLO DESARROLLO LOCAL. true rebaja OpenSSL a SECLEVEL=0 para el certificado SHA-1 de SWIS.
# OrionClient lo rechaza si APP_ENV no es local. No definirlo al desplegar SIALU.
ORION_LEGACY_TLS=false
# Consola web de Orion (Availability Statistics por nodo), con ORION_USERNAME/ORION_PASSWORD. Deshabilitada por
# defecto: la consola solo escucha HTTP y el inicio de sesión envía la contraseña en claro. No activar hasta
# tener transporte seguro.
ORION_WEB_URL=
ORION_WEB_STATS_ENABLED=false
# Minutos de AlertHistory releídos antes del avance (0-1440).
ORION_ALERT_HISTORY_OVERLAP_MINUTES=60
# Antigüedad máxima (min) de la instantánea de Orion.Nodes.Status que el tablero muestra como actual.
ORION_STATUS_MAX_AGE_MINUTES=15
# Días que se conservan las instantáneas de estado de nodos (1-365); la más reciente nunca se borra.
ORION_STATUS_RETENTION_DAYS=7
# Programador (servicio SialuScheduler): true ejecuta sialu:orion-status --persist cada 5 minutos.
ORION_STATUS_SCHEDULE_ENABLED=false
# Minutos que un bloqueo de una ejecución interrumpida impide la siguiente (1-60).
ORION_STATUS_SCHEDULE_LOCK_MINUTES=10
# Orion.Events DOWN/UP programado (sialu:sync orion --persist cada 5 min, cursor existente, sin --since).
# Requiere los GRANT de scripts/windows-service/grant-scheduler-sql.sql (incluye movdDisponibilidad).
ORION_EVENTS_SCHEDULE_ENABLED=false
ORION_EVENTS_SCHEDULE_LOCK_MINUTES=10
# Antigüedad máxima (min) de la última lectura completa de Orion.Events para mostrar la actividad DOWN/UP como actual.
ORION_EVENTS_MAX_AGE_MINUTES=15
# Palo Alto THREAT programado (solo sialu:sync paloalto-threat --persist, cursor existente, sin --since).
# TRAFFIC y paloalto-watch no se programan. Cada 5 min, hasta PAGE_SIZE × MAX_PAGES filas por ejecución.
PALOALTO_THREAT_SCHEDULE_ENABLED=false
PALOALTO_THREAT_SCHEDULE_LOCK_MINUTES=30
PALOALTO_THREAT_SCHEDULE_PAGE_SIZE=500
PALOALTO_THREAT_SCHEDULE_MAX_PAGES=20
# Cobertura y frescura (solo lectura). Retenciones observadas, aproximadas; la real decide la fecha exacta.
ORION_EVENTS_MAX_LAG_MINUTES=360
ORION_ALERTS_MAX_LAG_MINUTES=120
PALOALTO_MAX_LAG_MINUTES=30
ORION_EVENTS_OBSERVED_RETENTION_DAYS=30
ORION_ALERTS_OBSERVED_RETENTION_DAYS=3
PALOALTO_OBSERVED_RETENTION_DAYS=
INGESTION_LATE_MARGIN_MINUTES=60
# Inicio del historial de SIALU tras un reinicio de datos (YYYY-MM-DD o ISO 8601, UTC). Se ignora todo lo anterior.
SIALU_HISTORY_START=
PALOALTO_SOURCE_ID=
PALOALTO_HOST=
PALOALTO_PORT=443
PALOALTO_API_KEY=
PALOALTO_SSL_VERIFY=true
PALOALTO_TIMEZONE=
